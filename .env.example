# 复制成 .env 后填写：cp .env.example .env
# 不要把 .env 提交到 git / 发给别人（里面有 API Key）
# 想直接白嫖：用 .env.free.example（硅基流动一个 Key 免费搞定听+想+说）

# 云电脑的公网 IP 或可解析域名。只填主机，不要带 http://，不要带端口。
# 例：PUBLIC_HOST=1.2.3.4   或   PUBLIC_HOST=folo.example.com
PUBLIC_HOST=YOUR_PUBLIC_IP_OR_DOMAIN

# === 想 · 大脑（LLM）===
# 任意 OpenAI 兼容 /v1 地址：官方 OpenAI / DeepSeek / 智谱 / 硅基流动 / one-api / Ollama 网关。
# 【关键】LLM_MODEL 必须和 config/roles.json 里的 "model" 填同一个值。
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-YOUR_KEY
LLM_MODEL=gpt-4o-mini

# === 听 · 耳朵（STT）===
# STT_TYPE 可选：openai-whisper / azure-stt / azure-whisper / dify-stt / aliyun-asr / volcengine-asr
# 若大脑用 DeepSeek / 智谱（没有 whisper 接口），耳朵请单独指到硅基流动：
#   STT_API_BASE=https://api.siliconflow.cn/v1
#   STT_API_KEY=sk-YOUR_SILICONFLOW_KEY
#   STT_MODEL=FunAudioLLM/SenseVoiceSmall
STT_TYPE=openai-whisper
STT_API_BASE=https://api.openai.com/v1
STT_API_KEY=sk-YOUR_KEY
STT_MODEL=whisper-1

# === 说 · 嘴巴（TTS）===
# TTS_TYPE 可选：edge-tts(免费) / openai-tts / azure-tts / aliyun-tts / volcengine-tts / elevenlabs
TTS_TYPE=edge-tts

# 打开后对话事件会发布到 MQTT，供 xiaozhi_bridge.py 接进 ClawBot / 小智 MCP
INTEGRATION_MQTT=false

# 服务端连 EMQX 的密码（玩具侧不用，玩具仍是匿名接入）
MQTT_PASSWORD=folotoy

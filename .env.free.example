# ============================================================
# 火火兔「零成本 / 接近小智效果」配置模板
# 用法：cp .env.free.example .env  ->  填 PUBLIC_HOST 和下面的 Key
# 三段链路：听(STT) + 想(LLM) + 说(TTS)，各自独立选厂商，全部走免费档。
# 免费额度政策会变，申请前以各平台官网价格页为准。
# 【关键】改模型时：本文件的 LLM_MODEL 必须与 config/roles.json 的 "model" 一致。
# ============================================================

# 云电脑公网 IP / 域名（只填主机，不要带 http://、不要带端口）
PUBLIC_HOST=YOUR_PUBLIC_IP_OR_DOMAIN

# ------------------------------------------------------------
# 方案 A（默认，最省事）：硅基流动一个 Key 覆盖「听 + 想」
# 申请：https://cloud.siliconflow.cn -> 注册 + 实名认证 -> 控制台创建 API Key
#   · 必须实名认证后才能调用，否则 401
#   · 新用户赠约 2000 万 Token；9B 以下小模型长期免费
#   · 国内直连无需代理；一个 Key 还能直接调 DeepSeek / Qwen / GLM 等模型
# ------------------------------------------------------------

# === 想 · 大脑（LLM）===
#   模型名以控制台「模型列表」为准，复制全名。
#   长期免费档：Qwen/Qwen2.5-7B-Instruct、THUDM/glm-4-9b-chat
#   想更聪明（走赠送额度，用完极便宜）：deepseek-ai/DeepSeek-V3、Qwen/Qwen3-32B
LLM_API_BASE=https://api.siliconflow.cn/v1
LLM_API_KEY=sk-YOUR_SILICONFLOW_KEY
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# === 听 · 耳朵（STT）===
#   SenseVoiceSmall 免费，走 OpenAI 的 /audio/transcriptions 格式，中文识别质量好。
STT_TYPE=openai-whisper
STT_API_BASE=https://api.siliconflow.cn/v1
STT_API_KEY=sk-YOUR_SILICONFLOW_KEY
STT_MODEL=FunAudioLLM/SenseVoiceSmall

# === 说 · 嘴巴（TTS）===
#   edge-tts 免费、无需 Key；默认音色 zh-CN-XiaoxiaoNeural 温柔自然，适合陪孩子。
#   依赖云电脑能访问微软语音服务（国内一般可直连，非官方接口，不保证长期稳定）。
TTS_TYPE=edge-tts

# ------------------------------------------------------------
# 方案 B｜想要更聪明的大脑：DeepSeek 官网直连 + 免费耳朵
#   DeepSeek 不是免费，是按量计费(约 ¥1/百万 token 起)，但极便宜；中文与逻辑强。
#   把上面「想」三行改成下面三行，「听」三行保持不变即可：
#     LLM_API_BASE=https://api.deepseek.com
#     LLM_API_KEY=sk-YOUR_DEEPSEEK_KEY
#     LLM_MODEL=deepseek-chat
#   （DeepSeek 官网没有 STT 接口，所以耳朵必须留在硅基流动，这正是分开两组变量的意义）
#   记得同步把 config/roles.json 的 "model" 改成 deepseek-chat。
#
# 方案 C｜大脑永久免费且比 7B 聪明：智谱 GLM-4-Flash
#     LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
#     LLM_API_KEY=YOUR_ZHIPU_KEY
#     LLM_MODEL=glm-4-flash
#   中文强、永久免费不限量；耳朵仍用硅基流动。roles.json 的 "model" 同步改成 glm-4-flash。
#   （注意：glm-4-flash 非推理模型，走 openai 兼容的 chat/completions 没问题）
#
# 嘴巴想更稳/更自然：火山引擎 TTS 新用户 2 万字符免费(半年)，改 TTS_TYPE 并补对应 key；
#   edge-tts 在云电脑若不稳，再换它。
# ------------------------------------------------------------

# 接小智AI / ClawBot 的开关（详见 xiaozhi_bridge.py，接 ClawBot 小智 MCP 工具）
INTEGRATION_MQTT=false

# 服务端连 EMQX 的密码（玩具侧匿名接入，无需改）
MQTT_PASSWORD=folotoy
